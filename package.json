{
    "name": "sapm-monorepo",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "build": "npm --prefix frontend run build",
        "docker:full": "bash scripts/full_stack_docker.sh up",
        "docker:down": "bash scripts/full_stack_docker.sh down",
        "docker:logs": "bash scripts/full_stack_docker.sh logs",
        "docker:status": "bash scripts/full_stack_docker.sh status",
        "install:all": "npm ci --audit=false && npm --prefix agents/trader ci --audit=false && npm --prefix agents/aggregator ci --audit=false && npm --prefix agents/orchestrator ci --audit=false && npm --prefix frontend ci --audit=false",
        "test:trader": "npm --prefix agents/trader test",
        "test:aggregator": "npm --prefix agents/aggregator test",
        "test:all": "npm run test:trader && npm run test:aggregator && npm run test:orchestrator && node --test agents/lib/logger.test.js && node --test market-data/adapters/prediction-market-deepbook-bridge.test.js && node scripts/validate_canonical_schemas.js",
        "test:e2e": "jest test/e2e --testTimeout=10000",
        "test:reasoner-smoke": "node scripts/reasoner_smoke_test.js",
        "test:chaos": "node scripts/chaos_trading_scenarios.js",
        "test:load": "node scripts/load_test_trading.js",
        "check:schemas": "node scripts/validate_canonical_schemas.js",
        "check:frontend:prod": "bash scripts/frontend_production_gate.sh",
        "bench:aggregator": "node scripts/benchmark_aggregator.js",
        "lint": "eslint agents --ext .js",
        "lint:fix": "eslint agents --ext .js --fix",
        "release:check": "bash scripts/release_check.sh",
        "prepare": "husky install",
        "audit": "(cd agents/trader && npm audit) || true",
        "test:orchestrator": "npm --prefix agents/orchestrator test",
        "test:bridge": "node --test market-data/adapters/prediction-market-deepbook-bridge.test.js",
        "test:logger": "node --test agents/lib/logger.test.js",
        "demo:live": "node demo/demo_predict_live.js",
        "demo:trade": "node demo/demo_trading.js",
        "test:smoke": "node scripts/reasoner_smoke_test.js",
        "validate:schemas": "node scripts/validate_canonical_schemas.js"
    },
    "engines": {
        "node": ">=18"
    },
    "lint-staged": {
        "agents/**/*.js": [
            "npx eslint --fix",
            "git add"
        ]
    },
    "devDependencies": {
        "eslint": "^10.4.1",
        "husky": "^8.0.0",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.7"
    }
}
