{
  "name": "sapm-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm ci && npm --prefix agents/trader ci && npm --prefix agents/aggregator ci && npm --prefix agents/orchestrator ci && npm --prefix frontend ci",
    "test:trader": "npm --prefix agents/trader test",
    "test:aggregator": "npm --prefix agents/aggregator test",
    "test:orchestrator:experimental": "npm --prefix agents/orchestrator test 2>/dev/null || echo '⚠️  Orchestrator tests in progress'",
    "test:all": "npm run test:trader && npm run test:aggregator",
    "test:e2e": "jest test/e2e --testTimeout=10000",
    "test:chaos": "node scripts/chaos_trading_scenarios.js",
    "test:load": "node scripts/load_test_trading.js",
    "check:schemas": "node scripts/validate_canonical_schemas.js",
    "check:frontend:prod": "bash scripts/frontend_production_gate.sh",
    "bench:aggregator": "node scripts/benchmark_aggregator.js",
    "lint": "eslint agents --ext .js",
    "lint:fix": "eslint agents --ext .js --fix",
    "release:check": "bash scripts/release_check.sh",
    "prepare": "husky install",
    "audit": "(cd agents/trader && npm audit) || true"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "agents/**/*.js": [
      "npx eslint --fix",
      "git add"
    ]
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "husky": "^8.0.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.7"
  }
}
