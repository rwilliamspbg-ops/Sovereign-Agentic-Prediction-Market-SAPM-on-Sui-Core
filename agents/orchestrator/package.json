{
  "name": "@sapm/orchestrator",
  "version": "1.0.0",
  "description": "SAPM Orchestrator Core - Phase 1 Foundation for agent runtime orchestration",
  "main": "core/orchestrator.js",
  "scripts": {
    "start": "node core/orchestrator.js",
    "test": "jest test/",
    "test:watch": "jest --watch test/",
    "test:coverage": "jest --coverage test/",
    "lint": "eslint . --ext .js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "core/**/*.js",
      "discovery/**/*.js",
      "reputation/**/*.js",
      "tasks/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "keywords": [
    "sapm",
    "orchestrator",
    "federated-learning",
    "sui",
    "prediction-market"
  ],
  "author": "Sovereign Mohawk Proto LLC",
  "license": "MIT",
  "dependencies": {
    "@mysten/sui": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "jest": "^29.6.1"
  }
}
