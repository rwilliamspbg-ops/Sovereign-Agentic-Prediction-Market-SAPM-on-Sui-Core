# SAPM Mainnet Configuration
# DO NOT COMMIT THIS FILE TO GITHUB
# Copy to .env or frontend/.env.local and fill in your values

# Sui Network Configuration
SUI_NETWORK=mainnet
SUI_RPC=https://fullnode.mainnet.sui.io:443

# Mainnet Package IDs (set after sui client publish)
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_REGISTRY_OBJECT_ID=

# Mainnet Market Object IDs (set after create_market calls)
NEXT_PUBLIC_SUI_MARKET_OBJECT_IDS=

# Fee Configuration
PLATFORM_FEE_BASIS_POINTS=250
TREASURY_ADDRESS=

# Walrus Configuration (Mainnet)
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus.app
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus.app

# DeepBook Configuration (Mainnet - update when available)
NEXT_PUBLIC_DEEPBOOK_PREDICT_PACKAGE_ID=
NEXT_PUBLIC_DEEPBOOK_PREDICT_OBJECT_ID=
NEXT_PUBLIC_DEEPBOOK_PREDICT_SERVER=

# Agent Configuration
AGENT_RPC_TIMEOUT_MS=30000
AGENT_RETRY_MAX_ATTEMPTS=3
SUI_GAS_BUDGET=20000000
REGISTRY_PACKAGE_ID=
REGISTRY_MODULE=registry
REGISTRY_FUNCTION=add_key
REGISTRY_OBJ_ID=
AGG_SUI_SECRET=

# Security Settings
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.5
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# CopilotKit / OpenAI
OPENAI_API_KEY=
COPILOTKIT_MODEL=gpt-4o-mini
COPILOTKIT_TELEMETRY_DISABLED=true

# Next.js
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SUI_NETWORK=mainnet
NEXT_PUBLIC_ENABLE_BLIND_SIGNING_FALLBACK=false
