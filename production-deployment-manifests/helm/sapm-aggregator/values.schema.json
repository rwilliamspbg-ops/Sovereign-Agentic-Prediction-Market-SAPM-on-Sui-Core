{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SAPM Aggregator Helm Values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "global",
    "replicaCount",
    "aggregator",
    "securityContext",
    "service",
    "metrics",
    "autoscaling",
    "resourceQuota",
    "networkPolicy",
    "sysctlOptimizations",
    "deployment"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": ["imageRegistry", "imageTag"],
      "properties": {
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string", "minLength": 1 }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "aggregator": {
      "type": "object",
      "required": ["image", "xdp", "hugepages", "cpuAffinity", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "xdp": {
          "type": "object",
          "required": ["enabled", "networkInterface", "ringBufferSize", "packetMaxSize"],
          "properties": {
            "enabled": { "type": "boolean" },
            "networkInterface": { "type": "string", "minLength": 1 },
            "ringBufferSize": { "type": "integer", "minimum": 1024 },
            "packetMaxSize": { "type": "integer", "minimum": 512 }
          }
        },
        "hugepages": {
          "type": "object",
          "required": ["enabled", "count", "mountPath"],
          "properties": {
            "enabled": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0 },
            "mountPath": { "type": "string", "minLength": 1 }
          }
        },
        "cpuAffinity": { "type": "string", "minLength": 1 },
        "resources": {
          "type": "object",
          "required": ["limits", "requests"],
          "properties": {
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "minLength": 1 },
                "memory": { "type": "string", "minLength": 1 }
              }
            },
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "minLength": 1 },
                "memory": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["privileged", "capabilities", "readOnlyRootFilesystem", "allowPrivilegeEscalation"],
      "properties": {
        "privileged": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "required": ["add"],
          "properties": {
            "add": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "allowPrivilegeEscalation": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "resourceQuota": {
      "type": "object",
      "required": ["requestsCpu", "requestsMemory", "limitsCpu", "limitsMemory"],
      "properties": {
        "requestsCpu": { "type": "string", "minLength": 1 },
        "requestsMemory": { "type": "string", "minLength": 1 },
        "limitsCpu": { "type": "string", "minLength": 1 },
        "limitsMemory": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressRules": { "type": "array" },
        "egressRules": { "type": "array" }
      }
    },
    "sysctlOptimizations": {
      "type": "object",
      "required": [
        "vmNrHugepages",
        "vmMaxMapCount",
        "netCoreRmemMax",
        "netCoreWmemMax",
        "netIpv4TcpRmem",
        "netIpv4TcpWmem",
        "netCoreBpfJitEnable"
      ],
      "properties": {
        "vmNrHugepages": { "type": "integer", "minimum": 0 },
        "vmMaxMapCount": { "type": "integer", "minimum": 0 },
        "netCoreRmemMax": { "type": "integer", "minimum": 0 },
        "netCoreWmemMax": { "type": "integer", "minimum": 0 },
        "netIpv4TcpRmem": { "type": "string", "minLength": 1 },
        "netIpv4TcpWmem": { "type": "string", "minLength": 1 },
        "netCoreBpfJitEnable": { "type": "integer", "minimum": 0 }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["nameOverride", "namespaceOverride", "labels", "topologySpreadConstraints"],
      "properties": {
        "nameOverride": { "type": "string", "minLength": 1 },
        "namespaceOverride": { "type": "string" },
        "labels": { "type": "object" },
        "topologySpreadConstraints": {
          "type": "object",
          "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
          "properties": {
            "maxSkew": { "type": "integer", "minimum": 1 },
            "topologyKey": { "type": "string", "minLength": 1 },
            "whenUnsatisfiable": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
