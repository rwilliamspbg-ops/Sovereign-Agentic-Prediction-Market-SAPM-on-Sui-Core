# ─── Sui Network & RPC Configuration ────────────────────────────────────────
# Choose network: mainnet, testnet, devnet, localnet
SUI_NETWORK=mainnet

# RPC endpoint (optional, auto-selected based on SUI_NETWORK if not set)
SUI_RPC=https://fullnode.mainnet.sui.io:443

# Aggregator signing and commitment mode
STRICT_PROOF_ENFORCEMENT=1
REQUIRE_ONCHAIN_COMMIT=0
AGG_SECRET=

# Live on-chain commitment submission
REGISTRY_PACKAGE_ID=0xYOUR_MAINNET_PACKAGE_ID
REGISTRY_MODULE=registry
REGISTRY_FUNCTION=add_key
REGISTRY_OBJ_ID=0xYOUR_MAINNET_SHARED_OBJECT_ID
AGG_SUI_SECRET=

# Optional TLS (requires generated certs)
AGG_USE_TLS=0
TLS_CERT=agents/aggregator/certs/server.crt.pem
TLS_KEY=agents/aggregator/certs/server.key.pem

# ─── Fee Configuration ──────────────────────────────────────────────────────
# Platform fee in basis points (250 = 2.5%)
PLATFORM_FEE_BASIS_POINTS=250
# Treasury address for fee collection
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# ─── Gas Budget ─────────────────────────────────────────────────────────────
SUI_GAS_BUDGET=20000000

# ─── CopilotKit / OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
COPILOTKIT_MODEL=gpt-4o-mini

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─── Frontend (Next.js NEXT_PUBLIC_* vars) ───────────────────────────────────
# SAPM Move package ID on Sui mainnet (deploy to get your ID)
NEXT_PUBLIC_SUI_PACKAGE_ID=0xYOUR_MAINNET_PACKAGE_ID

# Sui network
NEXT_PUBLIC_SUI_NETWORK=mainnet

# DeepBook Predict (mainnet — update when DeepBook Predict deploys to mainnet)
NEXT_PUBLIC_DEEPBOOK_PREDICT_PACKAGE_ID=

# Comma-separated list of on-chain market object IDs
NEXT_PUBLIC_SUI_MARKET_OBJECT_IDS=

# SAPM registry shared object ID
NEXT_PUBLIC_SUI_REGISTRY_OBJECT_ID=0xYOUR_MAINNET_REGISTRY_OBJECT_ID

# Walrus mainnet endpoints
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus.app
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus.app
