# ─── Sui Network & RPC Configuration ────────────────────────────────────────
# Choose network: mainnet, testnet, devnet, localnet
SUI_NETWORK=testnet

# RPC endpoint (optional, auto-selected based on SUI_NETWORK if not set)
# Leave empty to auto-select from SUI_NETWORK, or override with custom RPC
SUI_RPC=

# Aggregator signing and commitment mode
STRICT_PROOF_ENFORCEMENT=1
REQUIRE_ONCHAIN_COMMIT=0
AGG_SECRET=base64-seed-for-aggregator-proof-signer

# Live on-chain commitment submission
REGISTRY_PACKAGE_ID=0xYOUR_PACKAGE_ID
REGISTRY_MODULE=registry
REGISTRY_FUNCTION=add_key
REGISTRY_OBJ_ID=0xYOUR_SHARED_OBJECT_ID
AGG_SUI_SECRET=suiprivkey... or base64-seed

# Optional TLS (requires generated certs)
AGG_USE_TLS=0
TLS_CERT=agents/aggregator/certs/server.crt.pem
TLS_KEY=agents/aggregator/certs/server.key.pem

# ─── CopilotKit / OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-TODO_REPLACE_WITH_YOUR_OPENAI_KEY
COPILOTKIT_MODEL=gpt-4o-mini

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─── Frontend (Next.js NEXT_PUBLIC_* vars) ───────────────────────────────────
# Copy these into frontend/.env.local (they must be prefixed NEXT_PUBLIC_ to be
# available in the browser bundle).

# SAPM Move package ID on Sui
# For testnet: 0x746797ce439d0e06bdb31d1b0dacc24e204e7906445292a97fb6a5734de777b8
# For mainnet: (deploy to get your mainnet package ID)
NEXT_PUBLIC_SUI_PACKAGE_ID=0x746797ce439d0e06bdb31d1b0dacc24e204e7906445292a97fb6a5734de777b8

# Sui network: testnet, mainnet, devnet
NEXT_PUBLIC_SUI_NETWORK=testnet

# DeepBook Predict (testnet, predict-testnet-4-16 branch)
NEXT_PUBLIC_DEEPBOOK_PREDICT_PACKAGE_ID=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138

# DeepBook Predict server (optional, auto-selected if not set)
NEXT_PUBLIC_DEEPBOOK_PREDICT_SERVER=

# Comma-separated list of on-chain market object IDs to load into the board.
# At least one valid 0x… Sui object ID is required for load-onchain-markets to succeed.
NEXT_PUBLIC_SUI_MARKET_OBJECT_IDS=0xYOUR_MARKET_OBJECT_ID_1,0xYOUR_MARKET_OBJECT_ID_2

# Optional: SAPM registry shared object ID (used by the copilot action handler)
NEXT_PUBLIC_SUI_REGISTRY_OBJECT_ID=0xYOUR_REGISTRY_OBJECT_ID

# Walrus testnet endpoints (defaults shown — override only if using a private node)
# NOTE: direct browser POSTs to the publisher are blocked by CORS.
# The frontend proxies publishes through Next.js rewrites at /api/walrus/blobs.
# You should NOT need to change these unless running against a local Walrus node.
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
