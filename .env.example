# Core
SUI_RPC=https://fullnode.testnet.sui.io:443
AGG_TOKEN=replace-with-random-token

# Aggregator signing and commitment mode
STRICT_PROOF_ENFORCEMENT=1
REQUIRE_ONCHAIN_COMMIT=0
AGG_SECRET=base64-seed-for-aggregator-proof-signer

# Live on-chain commitment submission
REGISTRY_PACKAGE_ID=0xYOUR_PACKAGE_ID
REGISTRY_MODULE=registry
REGISTRY_FUNCTION=add_key
REGISTRY_OBJ_ID=0xYOUR_SHARED_OBJECT_ID
AGG_SUI_SECRET=suiprivkey... or base64-seed

# Optional TLS (requires generated certs)
AGG_USE_TLS=0
TLS_CERT=agents/aggregator/certs/server.crt.pem
TLS_KEY=agents/aggregator/certs/server.key.pem
