# ─────────────────────────────────────────────────────────────────────────────
# SAPM Frontend Environment Template (Testnet)
# Copy this to .env.local and NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ─── Sui Network ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC=https://fullnode.testnet.sui.io:443

# ─── SAPM Deployed Package (Registry + incentives + prediction_market) ───────
NEXT_PUBLIC_SUI_PACKAGE_ID=0xee0b87415139cc95ec2b9c684f0abb0b6befeb21a02a7ca246c16dd8e25b8188

# ─── SAPM Registry shared object ─────────────────────────────────────────────
NEXT_PUBLIC_SUI_REGISTRY_OBJECT_ID=0xYOUR_REGISTRY_OBJECT_ID

# ─── Market object IDs (comma-separated, no spaces) ──────────────────────────
# ⚠️ CRITICAL: These must be REAL PredictionMarket objects, NOT the registry!
# After calling create_market(), add their object IDs here.
# Example: 0x...prediction_market_001,0x...prediction_market_002
NEXT_PUBLIC_SUI_MARKET_OBJECT_IDS=

# ─── Trade execution target (defaults to <package>::registry::add_key) ────────
NEXT_PUBLIC_SUI_TRADE_TARGET=

# ─── Sui system clock (always 0x6 on all Sui networks) ───────────────────────
NEXT_PUBLIC_SUI_CLOCK_OBJECT_ID=0x6

# ─── DeepBook Predict (testnet, predict-testnet-4-16 branch) ─────────────────
NEXT_PUBLIC_DEEPBOOK_PREDICT_PACKAGE_ID=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138
NEXT_PUBLIC_DEEPBOOK_PREDICT_OBJECT_ID=0xc8736204d12f0a7277c86388a68bf8a194b0a14c5538ad13f22cbd8e2a38028a
NEXT_PUBLIC_DEEPBOOK_PREDICT_REGISTRY=0x43af14fed5480c20ff77e2263d5f794c35b9fab7e2212903127062f4fe2a6e64
NEXT_PUBLIC_DEEPBOOK_PREDICT_SERVER=https://predict-server.testnet.mystenlabs.com

# ─── Walrus (testnet public nodes) ───────────────────────────────────────────
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# ─── Wallet — blind-signing fallback ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_BLIND_SIGNING_FALLBACK=true

# ─── CopilotKit / OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-TODO_REPLACE_WITH_YOUR_OPENAI_KEY_FROM_DASHBOARD
COPILOTKIT_MODEL=gpt-4o-mini
COPILOTKIT_TELEMETRY_DISABLED=true

# ─── Next.js ─────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
NEXT_DISABLE_FILE_SYSTEM_CACHE=1
NEXT_DISABLE_VERSION_CHECK=1
