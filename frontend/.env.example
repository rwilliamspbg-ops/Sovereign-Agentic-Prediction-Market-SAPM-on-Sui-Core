# ─────────────────────────────────────────────────────────────────────────────
# SAPM Frontend — Environment Variables
# Copy this file to .env.local and fill in the TODOs before running.
#
# STATIC values (already known, no changes needed):
#   DeepBook Predict IDs, Walrus endpoints, network
#
# TODO values (need your deployed contract output):
#   NEXT_PUBLIC_SUI_PACKAGE_ID
#   NEXT_PUBLIC_SUI_REGISTRY_OBJECT_ID
#   NEXT_PUBLIC_SUI_MARKET_OBJECT_IDS
# ─────────────────────────────────────────────────────────────────────────────

# ─── Sui Network ─────────────────────────────────────────────────────────────
# Network selection: testnet, mainnet, devnet
SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_NETWORK=testnet

# ─── Sui RPC (optional, auto-selected from SUI_NETWORK if not set) ────────────
SUI_RPC=

# ─── SAPM Deployed Contracts (fill in after: sui move publish) ─────────────
# Testnet default (used for demo):
NEXT_PUBLIC_SUI_PACKAGE_ID=0x746797ce439d0e06bdb31d1b0dacc24e204e7906445292a97fb6a5734de777b8
# For mainnet, deploy and update to your mainnet package ID

# ─── DeepBook Predict (testnet — no changes needed) ──────────────────────────
# Source: https://docs.sui.io/onchain-finance/deepbook-predict/contract-information
NEXT_PUBLIC_DEEPBOOK_PREDICT_PACKAGE_ID=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138
NEXT_PUBLIC_DEEPBOOK_PREDICT_OBJECT_ID=0xc8736204d12f0a7277c86388a68bf8a194b0a14c5538ad13f22cbd8e2a38028a
NEXT_PUBLIC_DEEPBOOK_PREDICT_REGISTRY=0x43af14fed5480c20ff77e2263d5f794c35b9fab7e2212903127062f4fe2a6e64
NEXT_PUBLIC_DEEPBOOK_PREDICT_SERVER=https://predict-server.testnet.mystenlabs.com

# ─── Walrus (testnet — no changes needed) ────────────────────────────────────
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# ─── CopilotKit / OpenAI (required for SAPM Copilot) ─────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-TODO_REPLACE_WITH_YOUR_OPENAI_KEY
COPILOTKIT_MODEL=gpt-4o-mini

SUI_RPC=https://fullnode.testnet.sui.io:443
AGG_TOKEN=replace-with-random-token
STRICT_PROOF_ENFORCEMENT=1
REQUIRE_ONCHAIN_COMMIT=0
AGG_SECRET=base64-seed-for-aggregator-proof-signer
REGISTRY_MODULE=registry
REGISTRY_FUNCTION=add_key

# ─── Next.js dev experience ───────────────────────────────────────────────────
# Disables telemetry AND the "Next.js (14.x) is outdated" dev-overlay banner.
# 14.2.35 is the latest 14.x patch — a major-version upgrade to 15/16 is a
# separate migration task. Remove this line when you perform that migration.
NEXT_TELEMETRY_DISABLED=1
