{
  "name": "sapm-frontend",
  "version": "1.0.0",
  "description": "SAPM Production Frontend - Next.js with TypeScript and Tailwind CSS",
  "scripts": {
    "dev": "npx cross-env NEXT_DISABLE_FILE_SYSTEM_CACHE=1 NEXT_DISABLE_VERSION_CHECK=1 next dev",
    "clean": "rm -rf .next node_modules",
    "reset": "npm run clean && npm install",
    "prebuild": "npm run type-check",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.60.1",
    "@copilotkit/react-ui": "^1.60.1",
    "@copilotkit/runtime": "^1.60.1",
    "@heroicons/react": "^2.2.0",
    "@mysten/sui": "^1.45.2",
    "@mysten/wallet-standard": "^0.12.14",
    "@tanstack/react-query": "^5.20.0",
    "@wallet-standard/app": "1.0.1",
    "clsx": "^2.1.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.363.0",
    "next": "16.2.9",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-config-next": "16.2.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "5.4.5"
  },
  "overrides": {
    "glob": "^10.5.0",
    "minimatch": "^9.0.9",
    "prismjs": "^1.30.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.1"
  }
}
